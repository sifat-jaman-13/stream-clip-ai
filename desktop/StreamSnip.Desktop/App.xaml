<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="StreamSnip_Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StreamSnip_Desktop">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="AppFont">ms-appx:///Assets/Fonts/JetBrainsMono-Variable.ttf#JetBrains Mono</FontFamily>
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#282C34" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#1B2028" />
            <SolidColorBrush x:Key="SurfaceSoftBrush" Color="#232B35" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#2D3743" />
            <SolidColorBrush x:Key="SidebarBrush" Color="#171C23" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E8F0F4" />
            <SolidColorBrush x:Key="BodyTextBrush" Color="#C8D5DC" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#9CDEF2" />
            <SolidColorBrush x:Key="LineBrush" Color="#355A66" />
            <SolidColorBrush x:Key="AccentBrush" Color="#E06C75" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#3B2C33" />
            <SolidColorBrush x:Key="AccentInkBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#80C99A" />
            <SolidColorBrush x:Key="WarningBrush" Color="#E6B96F" />
            <SolidColorBrush x:Key="DangerBrush" Color="#E06C75" />

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="Background" Value="{StaticResource SurfaceSoftBrush}" />
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="Background" Value="{StaticResource SurfaceSoftBrush}" />
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            </Style>
            <Style TargetType="PasswordBox">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="Background" Value="{StaticResource SurfaceSoftBrush}" />
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style TargetType="AutoSuggestBox">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="MinHeight" Value="48" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
            </Style>
            <Style TargetType="RadioButton">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
