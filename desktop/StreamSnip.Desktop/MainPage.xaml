<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StreamSnip_Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    Background="{ThemeResource AppBackgroundBrush}">
    <Page.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="SidebarSurfaceBrush" Color="#212121" />
            <SolidColorBrush x:Key="SidebarTextBrush" Color="#F1F1F1" />
            <SolidColorBrush x:Key="SidebarBodyTextBrush" Color="#D6D6D6" />
            <SolidColorBrush x:Key="SidebarMutedTextBrush" Color="#AAAAAA" />
            <SolidColorBrush x:Key="SidebarLineBrush" Color="#303030" />
        </ResourceDictionary>
    </Page.Resources>
    <Grid x:Name="RootLayoutGrid" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="SidebarRoot" Grid.Column="0" Background="{ThemeResource SidebarBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="82" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="100" />
            </Grid.RowDefinitions>

            <Border x:Name="SidebarBrandBorder" Grid.Row="0" Padding="20,16,14,12" Background="{ThemeResource SidebarBrush}">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="9" Background="{ThemeResource AccentBrush}">
                        <Image Source="ms-appx:///Assets/app-icon.png" Stretch="Uniform" Margin="5" />
                    </Border>
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock x:Name="SidebarBrandTitleText" Text="StreamSnip AI" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource SidebarTextBrush}" />
                        <TextBlock x:Name="SidebarBrandSubtitleText" Text="CREATOR STUDIO" FontSize="12" Foreground="{ThemeResource SidebarMutedTextBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="SidebarWorkspaceBorder" Grid.Row="1" Margin="14,5,14,10" Padding="13,9"
                    Background="{ThemeResource SidebarSurfaceBrush}"
                    BorderBrush="{ThemeResource SidebarLineBrush}" BorderThickness="1" CornerRadius="8">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="9" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="SidebarEngineDot" Width="8" Height="8"
                             Fill="{ThemeResource WarningBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="SidebarWorkspaceTitleText" Text="Local workspace" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource SidebarTextBrush}" />
                        <TextBlock x:Name="SidebarWorkspaceDeviceText" Text="This device" FontSize="12" Foreground="{ThemeResource SidebarMutedTextBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Padding="12,10,12,14" Spacing="3">
                    <TextBlock x:Name="SidebarStudioLabel" Text="STUDIO" Margin="10,6,0,8" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SidebarMutedTextBrush}" />
                    <Button x:Name="NavOverviewButton" AutomationProperties.Name="Dashboard" Tag="overview" Click="NavItem_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="Transparent" Foreground="{ThemeResource SidebarBodyTextBrush}"
                            BorderBrush="Transparent" BorderThickness="1" Padding="14,9"
                            CornerRadius="8" MinHeight="46">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <TextBlock Text="Dashboard" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavLiveButton" AutomationProperties.Name="Live Studio" Tag="live" Click="NavItem_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="Transparent" Foreground="{ThemeResource SidebarBodyTextBrush}"
                            BorderBrush="Transparent" BorderThickness="1" Padding="14,9"
                            CornerRadius="8" MinHeight="46">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <TextBlock Text="Live Studio" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavCreatorsButton" AutomationProperties.Name="Creators" Tag="creators" Click="NavItem_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="Transparent" Foreground="{ThemeResource SidebarBodyTextBrush}"
                            BorderBrush="Transparent" BorderThickness="1" Padding="14,9"
                            CornerRadius="8" MinHeight="46">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <TextBlock Text="Creators" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock x:Name="SidebarLibraryLabel" Text="LIBRARY" Margin="10,20,0,8" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SidebarMutedTextBrush}" />
                    <Button x:Name="NavClipsButton" AutomationProperties.Name="Clip library" Tag="clips" Click="NavItem_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="Transparent" Foreground="{ThemeResource SidebarBodyTextBrush}"
                            BorderBrush="Transparent" BorderThickness="1" Padding="14,9"
                            CornerRadius="8" MinHeight="46">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <TextBlock Text="Clip library" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavPublishedButton" AutomationProperties.Name="Scheduled" Tag="published" Click="NavItem_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="Transparent" Foreground="{ThemeResource SidebarBodyTextBrush}"
                            BorderBrush="Transparent" BorderThickness="1" Padding="14,9"
                            CornerRadius="8" MinHeight="46">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <TextBlock Text="Scheduled" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavWordsButton" AutomationProperties.Name="Hype words" Tag="words" Click="NavItem_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="Transparent" Foreground="{ThemeResource SidebarBodyTextBrush}"
                            BorderBrush="Transparent" BorderThickness="1" Padding="14,9"
                            CornerRadius="8" MinHeight="46">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <TextBlock Text="Hype words" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock x:Name="SidebarManageLabel" Text="MANAGE" Margin="10,20,0,8" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SidebarMutedTextBrush}" />
                    <Button x:Name="NavPublishingButton" AutomationProperties.Name="Publisher" Tag="publishing" Click="NavItem_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="Transparent" Foreground="{ThemeResource SidebarBodyTextBrush}"
                            BorderBrush="Transparent" BorderThickness="1" Padding="14,9"
                            CornerRadius="8" MinHeight="46">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <TextBlock Text="Publisher" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavProvidersButton" AutomationProperties.Name="Providers" Tag="providers" Click="NavItem_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="Transparent" Foreground="{ThemeResource SidebarBodyTextBrush}"
                            BorderBrush="Transparent" BorderThickness="1" Padding="14,9"
                            CornerRadius="8" MinHeight="46">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <TextBlock Text="AI &amp; Providers" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavSettingsButton" AutomationProperties.Name="Settings" Tag="settings" Click="NavItem_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="Transparent" Foreground="{ThemeResource SidebarBodyTextBrush}"
                            BorderBrush="Transparent" BorderThickness="1" Padding="14,9"
                            CornerRadius="8" MinHeight="46">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <TextBlock Text="Settings" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavActivityButton" AutomationProperties.Name="Activity" Tag="activity" Click="NavItem_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="Transparent" Foreground="{ThemeResource SidebarBodyTextBrush}"
                            BorderBrush="Transparent" BorderThickness="1" Padding="14,9"
                            CornerRadius="8" MinHeight="46">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <TextBlock Text="Activity" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <Border x:Name="SidebarEngineBorder" Grid.Row="3" Margin="14,7,14,7" Padding="13,10"
                    Background="{ThemeResource SidebarSurfaceBrush}"
                    BorderBrush="{ThemeResource SidebarLineBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="3">
                    <TextBlock x:Name="SidebarEngineText" Text="Connecting to engine" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource SidebarTextBrush}" />
                    <TextBlock x:Name="SidebarLocalProcessingText" Text="LOCAL PROCESSING" FontSize="11" Foreground="{ThemeResource SidebarMutedTextBrush}" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="4" Padding="12,8,12,10" Spacing="3" VerticalAlignment="Bottom">
                <Button x:Name="NavHelpButton" AutomationProperties.Name="Help" Tag="help" Click="NavItem_Click"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Background="Transparent" Foreground="{ThemeResource SidebarBodyTextBrush}"
                        BorderBrush="Transparent" BorderThickness="1" Padding="14,8"
                        CornerRadius="8" MinHeight="44">
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <TextBlock Text="Help" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavAboutButton" AutomationProperties.Name="About" Tag="about" Click="NavItem_Click"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Background="Transparent" Foreground="{ThemeResource SidebarBodyTextBrush}"
                        BorderBrush="Transparent" BorderThickness="1" Padding="14,8"
                        CornerRadius="8" MinHeight="44">
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <TextBlock Text="About" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="76" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="46" />
            </Grid.RowDefinitions>

            <Grid x:Name="TopBarRoot" Grid.Row="0" Padding="34,0,34,0"
                  Background="{ThemeResource SurfaceBrush}"
                  BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                    <TextBlock x:Name="TopBarBrandText" Text="StreamSnip AI" Foreground="{ThemeResource MutedTextBrush}" FontSize="14" />
                    <Border x:Name="TopBarDivider" Width="1" Height="20" Background="{ThemeResource LineBrush}" />
                    <TextBlock x:Name="PageTitleText" Text="Dashboard" FontSize="24" FontWeight="SemiBold" />
                </StackPanel>

                <AutoSuggestBox x:Name="GlobalSearchBox" Grid.Column="1"
                                Height="48" PlaceholderText="Search clips"
                                TextChanged="GlobalSearchBox_TextChanged"
                                QuerySubmitted="GlobalSearchBox_QuerySubmitted"
                                VerticalAlignment="Center">
                    <AutoSuggestBox.QueryIcon>
                        <PathIcon x:Name="SearchQueryIcon" Width="16" Height="16"
                                  Foreground="{ThemeResource MutedTextBrush}" />
                    </AutoSuggestBox.QueryIcon>
                </AutoSuggestBox>

                <Border x:Name="EngineStatusBorder" Grid.Column="2" Margin="16,0,8,0" Padding="12,7"
                        VerticalAlignment="Center" CornerRadius="8"
                        Background="{ThemeResource SurfaceSoftBrush}"
                        BorderBrush="{ThemeResource LineBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse x:Name="EngineStatusDot" Width="8" Height="8" Fill="{ThemeResource WarningBrush}" />
                        <TextBlock x:Name="EngineStatusText" Text="Starting engine…" FontSize="14" Foreground="{ThemeResource BodyTextBrush}" />
                    </StackPanel>
                </Border>

                <Button x:Name="HelpButton" Grid.Column="3" Width="46" Height="46" Padding="0" Margin="6,0"
                        VerticalAlignment="Center" Background="Transparent"
                        BorderBrush="{ThemeResource LineBrush}" BorderThickness="1"
                        Click="HelpButton_Click" ToolTipService.ToolTip="Help"
                        AutomationProperties.Name="Help">
                    <TextBlock x:Name="HelpButtonText" Text="?" FontFamily="{ThemeResource AppFont}" FontSize="14"
                               Foreground="{ThemeResource MutedTextBrush}" />
                </Button>
                <Button x:Name="QuitButton" Grid.Column="4" Content="Quit"
                        MinWidth="88" Margin="6,0" Padding="16,8" VerticalAlignment="Center"
                        Background="{ThemeResource SurfaceBrush}"
                        Foreground="{ThemeResource BodyTextBrush}"
                        BorderBrush="{ThemeResource LineBrush}" BorderThickness="1"
                        CornerRadius="8" Click="QuitButton_Click" />
            </Grid>

            <ScrollViewer x:Name="ContentScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PageHost" Padding="40,34,40,52" Spacing="28" />
            </ScrollViewer>

            <Border x:Name="PageActionHost" Grid.Row="2" Padding="34,10"
                    Background="{ThemeResource SurfaceBrush}"
                    BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0"
                    Visibility="Collapsed" />
            <Grid x:Name="FooterRoot" Grid.Row="3" Padding="34,0"
                  Background="{ThemeResource SurfaceBrush}"
                  BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <Ellipse x:Name="FooterEngineDot" Width="7" Height="7" Fill="{ThemeResource WarningBrush}" />
                    <TextBlock x:Name="FooterEngineText" Text="Local engine" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
                    <TextBlock x:Name="FooterSeparatorText" Text="·" Foreground="{ThemeResource LineBrush}" />
                    <TextBlock x:Name="FooterLocalMessageText" Text="Capture and rendering stay on this PC" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
                </StackPanel>
                <TextBlock x:Name="FooterVersionText" Grid.Column="2" Text="StreamSnip AI  ·  4.1.0" FontSize="14" Foreground="{ThemeResource MutedTextBrush}" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Grid>
</Page>