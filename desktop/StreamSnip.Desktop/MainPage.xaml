<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StreamSnip_Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    Background="{StaticResource AppBackgroundBrush}">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="SidebarRoot" Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="82" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="100" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="20,16,14,12" Background="{StaticResource SidebarBrush}">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="9" Background="{StaticResource AccentBrush}">
                        <Image Source="ms-appx:///Assets/app-icon.png" Stretch="Uniform" Margin="5" />
                    </Border>
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="StreamSnip AI" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="CREATOR STUDIO" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Margin="14,5,14,10" Padding="13,9"
                    Background="{StaticResource SurfaceSoftBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="9" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="SidebarEngineDot" Width="8" Height="8"
                             Fill="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Local workspace" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="This device" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Padding="12,10,12,14" Spacing="3">
                    <TextBlock Text="STUDIO" Margin="10,6,0,8" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                    <Button x:Name="NavOverviewButton" AutomationProperties.Name="Dashboard" Tag="overview" Click="NavItem_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="Transparent" Foreground="{StaticResource BodyTextBrush}"
                            BorderBrush="Transparent" BorderThickness="1" Padding="14,9"
                            CornerRadius="8" MinHeight="46">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <TextBlock Text="Dashboard" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavLiveButton" AutomationProperties.Name="Live Studio" Tag="live" Click="NavItem_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="Transparent" Foreground="{StaticResource BodyTextBrush}"
                            BorderBrush="Transparent" BorderThickness="1" Padding="14,9"
                            CornerRadius="8" MinHeight="46">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <TextBlock Text="Live Studio" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavCreatorsButton" AutomationProperties.Name="Creators" Tag="creators" Click="NavItem_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="Transparent" Foreground="{StaticResource BodyTextBrush}"
                            BorderBrush="Transparent" BorderThickness="1" Padding="14,9"
                            CornerRadius="8" MinHeight="46">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <TextBlock Text="Creators" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="LIBRARY" Margin="10,20,0,8" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                    <Button x:Name="NavClipsButton" AutomationProperties.Name="Clip library" Tag="clips" Click="NavItem_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="Transparent" Foreground="{StaticResource BodyTextBrush}"
                            BorderBrush="Transparent" BorderThickness="1" Padding="14,9"
                            CornerRadius="8" MinHeight="46">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <TextBlock Text="Clip library" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavPublishedButton" AutomationProperties.Name="Scheduled" Tag="published" Click="NavItem_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="Transparent" Foreground="{StaticResource BodyTextBrush}"
                            BorderBrush="Transparent" BorderThickness="1" Padding="14,9"
                            CornerRadius="8" MinHeight="46">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <TextBlock Text="Scheduled" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavWordsButton" AutomationProperties.Name="Hype words" Tag="words" Click="NavItem_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="Transparent" Foreground="{StaticResource BodyTextBrush}"
                            BorderBrush="Transparent" BorderThickness="1" Padding="14,9"
                            CornerRadius="8" MinHeight="46">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <TextBlock Text="Hype words" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="MANAGE" Margin="10,20,0,8" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                    <Button x:Name="NavPublishingButton" AutomationProperties.Name="Publisher" Tag="publishing" Click="NavItem_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="Transparent" Foreground="{StaticResource BodyTextBrush}"
                            BorderBrush="Transparent" BorderThickness="1" Padding="14,9"
                            CornerRadius="8" MinHeight="46">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <TextBlock Text="Publisher" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavSettingsButton" AutomationProperties.Name="Settings" Tag="settings" Click="NavItem_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="Transparent" Foreground="{StaticResource BodyTextBrush}"
                            BorderBrush="Transparent" BorderThickness="1" Padding="14,9"
                            CornerRadius="8" MinHeight="46">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <TextBlock Text="Settings" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavActivityButton" AutomationProperties.Name="Activity" Tag="activity" Click="NavItem_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="Transparent" Foreground="{StaticResource BodyTextBrush}"
                            BorderBrush="Transparent" BorderThickness="1" Padding="14,9"
                            CornerRadius="8" MinHeight="46">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <TextBlock Text="Activity" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="3" Margin="14,7,14,7" Padding="13,10"
                    Background="{StaticResource SurfaceSoftBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="3">
                    <TextBlock x:Name="SidebarEngineText" Text="Connecting to engine" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="LOCAL PROCESSING" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="4" Padding="12,8,12,10" Spacing="3" VerticalAlignment="Bottom">
                <Button x:Name="NavHelpButton" AutomationProperties.Name="Help" Tag="help" Click="NavItem_Click"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Background="Transparent" Foreground="{StaticResource BodyTextBrush}"
                        BorderBrush="Transparent" BorderThickness="1" Padding="14,8"
                        CornerRadius="8" MinHeight="44">
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <TextBlock Text="Help" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavAboutButton" AutomationProperties.Name="About" Tag="about" Click="NavItem_Click"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Background="Transparent" Foreground="{StaticResource BodyTextBrush}"
                        BorderBrush="Transparent" BorderThickness="1" Padding="14,8"
                        CornerRadius="8" MinHeight="44">
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <TextBlock Text="About" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="76" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="46" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="34,0,34,0"
                  Background="{StaticResource SurfaceBrush}"
                  BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                    <TextBlock Text="StreamSnip AI" Foreground="{StaticResource MutedTextBrush}" FontSize="14" />
                    <Border Width="1" Height="20" Background="{StaticResource LineBrush}" />
                    <TextBlock x:Name="PageTitleText" Text="Dashboard" FontSize="24" FontWeight="SemiBold" />
                </StackPanel>

                <AutoSuggestBox x:Name="GlobalSearchBox" Grid.Column="1"
                                Height="48" PlaceholderText="Search clips"
                                QueryIcon="Find" TextChanged="GlobalSearchBox_TextChanged"
                                QuerySubmitted="GlobalSearchBox_QuerySubmitted"
                                VerticalAlignment="Center" />

                <Border Grid.Column="2" Margin="16,0,8,0" Padding="12,7"
                        VerticalAlignment="Center" CornerRadius="8"
                        Background="{StaticResource SurfaceSoftBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse x:Name="EngineStatusDot" Width="8" Height="8" Fill="{StaticResource WarningBrush}" />
                        <TextBlock x:Name="EngineStatusText" Text="Starting engine…" FontSize="14" Foreground="{StaticResource BodyTextBrush}" />
                    </StackPanel>
                </Border>

                <Button x:Name="AppearanceButton" Grid.Column="3" Width="46" Height="46" Padding="0"
                        Margin="6,0" VerticalAlignment="Center" Background="Transparent"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        ToolTipService.ToolTip="Appearance and themes"
                        Click="AppearanceButton_Click" AutomationProperties.Name="Change theme">
                    <TextBlock Text="Aa" FontFamily="{ThemeResource AppFont}" FontSize="14"
                               Foreground="{StaticResource MutedTextBrush}" />
                </Button>
                <Button Grid.Column="4" Width="46" Height="46" Padding="0" Margin="6,0"
                        VerticalAlignment="Center" Background="Transparent"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        Click="HelpButton_Click" ToolTipService.ToolTip="Help"
                        AutomationProperties.Name="Help">
                    <TextBlock Text="?" FontFamily="{ThemeResource AppFont}" FontSize="14"
                               Foreground="{StaticResource MutedTextBrush}" />
                </Button>
                <Button x:Name="QuitButton" Grid.Column="5" Content="Quit"
                        MinWidth="88" Margin="6,0" VerticalAlignment="Center"
                        Click="QuitButton_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PageHost" Padding="40,34,40,52" Spacing="28" />
            </ScrollViewer>

            <Border x:Name="PageActionHost" Grid.Row="2" Padding="34,10"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                    Visibility="Collapsed" />
            <Grid Grid.Row="3" Padding="34,0"
                  Background="{StaticResource SurfaceBrush}"
                  BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <Ellipse x:Name="FooterEngineDot" Width="7" Height="7" Fill="{StaticResource WarningBrush}" />
                    <TextBlock x:Name="FooterEngineText" Text="Local engine" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="·" Foreground="{StaticResource LineBrush}" />
                    <TextBlock Text="Capture and rendering stay on this PC" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="StreamSnip AI  ·  4.0.9" FontSize="14" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Grid>
</Page>